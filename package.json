{
  "name": "calendaction",
  "version": "1.0.0",
  "description": "CalendAction MERN starter",
  "scripts": {
    "install:all": "npm install && npm install --prefix my-app/frontend && npm install --prefix my-app/backend",
    "dev": "concurrently -k -n frontend,backend -c cyan,green \"npm run dev --prefix my-app/frontend\" \"npm run dev --prefix my-app/backend\"",
    "dev:frontend": "npm run dev --prefix my-app/frontend",
    "dev:backend": "npm run dev --prefix my-app/backend",
    "build": "npm run build --prefix my-app/frontend",
    "start": "npm start --prefix my-app/backend"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AriunBayasgalan/CalendAction.git"
  },
  "bugs": {
    "url": "https://github.com/AriunBayasgalan/CalendAction/issues"
  },
  "homepage": "https://github.com/AriunBayasgalan/CalendAction#readme",
  "private": true,
  "devDependencies": {
    "concurrently": "^10.0.5"
  },
  "overrides": {
    "shell-quote": "1.12.0"
  }
}
